# CLOSE INTELLIGENCE — environment template. Copy to .env or set these in your host's
# secret manager. This file contains no secrets and none are required to try the app.

# Port the server listens on.
PORT=4600

# Where databases and uploaded files are stored. Demo and Live are kept in separate
# sub-folders (data/demo, data/live). Back up the "live" folder.
# CI_DATA_DIR=/var/lib/close-intelligence

# Key used to encrypt stored secrets (such as an OpenAI API key saved in Settings) and to
# sign download links. Required for any shared or production deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in a secret manager, separate from the database and its backups. If it is unset,
# a local development key file is created under the data folder — fine for a laptop only.
CI_SECRET_KEY=

# Set to 1 when the app is served over HTTPS so session cookies are marked Secure.
CI_SECURE_COOKIES=0

# Hours before a signed-in session expires.
CI_SESSION_HOURS=12

# Optional. Supply the OpenAI API key from the environment instead of saving it in Settings.
# Used by the Live environment only; Demo never calls OpenAI unless explicitly enabled.
# OPENAI_API_KEY=

# Optional. Override the OpenAI API base URL (for a regional endpoint or a test double).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Developer tooling only: folder containing esbuild / typescript / playwright when they are
# not installed in ./node_modules, and the Chrome executable for browser tests.
# CI_NODE_PATH=
# CI_CHROME=
